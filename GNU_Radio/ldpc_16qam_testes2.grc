- name: epy_block_1_0
  id: epy_block
  parameters:
    _source_code: "import threading, time\nimport numpy as np\nimport pmt\nfrom gnuradio\
      \ import gr\n\nclass blk(gr.sync_block):\n    \"\"\"Repassa o fluxo e conta\
      \ tags 'packet_len' em stats[name].\"\"\"\n    def __init__(self, stats=None,\
      \ name='ok', key='packet_len',\n                 report=False):\n        gr.sync_block.__init__(self,\
      \ name='Tag counter',\n                               in_sig=[np.uint8], out_sig=[np.uint8])\n\
      \        self.stats = stats if stats is not None else {'det': 0, 'ok': 0}\n\
      \        self.cname = name\n        self.key = pmt.intern(key)\n        self.report\
      \ = report\n        self._run = False\n        self.stats.setdefault(name, 0)\n\
      \n    def work(self, input_items, output_items):\n        n = len(input_items[0])\n\
      \        output_items[0][:n] = input_items[0]\n        tags = self.get_tags_in_window(0,\
      \ 0, n, self.key)\n        self.stats[self.cname] += len(tags)\n        return\
      \ n\n\n    def _print(self, tag):\n        det = self.stats.get('det', 0)\n\
      \        ok = self.stats.get('ok', 0)\n        N = self.stats.get('n_total',\
      \ 0)\n        if N:\n            print(f\"[{tag}] N={N} | det={det} ({det/N:.4f})\
      \ | \"\n                  f\"ok={ok} ({ok/N:.4f}) | \"\n                  f\"\
      BLER|det={(det-ok)/max(det,1):.3e} | \"\n                  f\"BLER total={(N-ok)/N:.3e}\"\
      )\n\n    def _loop(self):\n        prev, calmo = None, 0\n        while self._run:\n\
      \            time.sleep(1.0)\n            self._print('parcial')\n         \
      \   cur = (self.stats.get('det', 0), self.stats.get('ok', 0))\n            calmo\
      \ = calmo + 1 if (cur == prev and cur[0] > 0) else 0\n            prev = cur\n\
      \            if calmo >= 3:\n                self._print('FINAL')\n        \
      \        break\n\n    def start(self):\n        if self.report:\n          \
      \  self._run = True\n            threading.Thread(target=self._loop, daemon=True).start()\n\
      \        return True\n\n    def stop(self):\n        self._run = False\n   \
      \     return True\n"
    affinity: ''
    alias: ''
    comment: ''
    key: '''packet_len'''
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '''det'''
    report: 'False'
    stats: stats
  states:
    _io_cache: ('Tag counter', 'blk', [('stats', 'None'), ('name', "'ok'"), ('key',
      "'packet_len'"), ('report', 'False')], [('0', 'byte', 1)], [('0', 'byte', 1)],
      "Repassa o fluxo e conta tags 'packet_len' em stats[name].", ['key', 'report',
      'stats'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1832, 1128.0]
    rotation: 0
    state: enabled
